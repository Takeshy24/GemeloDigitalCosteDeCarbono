# Conexión local PostgreSQL. No publiques un .env real.
DATABASE_URL=postgresql+psycopg://carbon_user:2005@localhost:5432/carbon_twins

# Opcional: habilita IA generativa con LangChain y Gemini en el backend FastAPI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Langflow opcional (el backend lee estos valores desde backend/.env).
LANGFLOW_URL=http://localhost:7860
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=
LANGFLOW_TIMEOUT_SECONDS=60
