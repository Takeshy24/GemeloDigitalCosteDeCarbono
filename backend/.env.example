# No subas este archivo como .env al repositorio si contiene secretos reales.
DATABASE_URL=postgresql+psycopg://carbon_user:2005@localhost:5432/carbon_twins
CORS_ORIGINS=http://localhost:3000
# Opcional: habilita el asistente LangChain del gemelo digital con Gemini.
# La clave permanece exclusivamente en FastAPI; nunca se expone al navegador.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional: Langflow se convierte en el orquestador principal cuando los tres
# valores están definidos. Si falla, FastAPI continúa con LangChain.
LANGFLOW_URL=http://localhost:7860
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=
LANGFLOW_TIMEOUT_SECONDS=60

# Entrenamiento local. Render lo deshabilita y usa requirements-runtime.txt.
ML_TRAINING_ENABLED=true
# Para mover artefactos, exporta ML_ARTIFACTS_DIR en el entorno del proceso
# antes de arrancar la API o el laboratorio; por defecto backend/ml_artifacts.
