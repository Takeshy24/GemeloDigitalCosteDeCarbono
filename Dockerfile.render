# Frontend y API comparten un único servicio Free y el mismo origen.
FROM node:22-bookworm-slim AS frontend
WORKDIR /build
ENV NEXT_TELEMETRY_DISABLED=1 NEXT_STATIC_EXPORT=1
COPY package.json package-lock.json ./
RUN npm ci --include=dev
COPY next.config.ts next-env.d.ts tsconfig.json postcss.config.mjs ./
COPY app ./app
COPY src ./src
RUN npm run build

FROM python:3.11-slim-bookworm AS runtime
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 FRONTEND_DIST_DIR=/app/frontend \
    ML_TRAINING_ENABLED=false OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY backend/requirements-runtime.txt ./backend/requirements-runtime.txt
RUN pip install -r backend/requirements-runtime.txt
COPY backend/app ./backend/app
COPY backend/ml_artifacts ./backend/ml_artifacts
COPY --from=frontend /build/out ./frontend
EXPOSE 10000
CMD ["sh", "-c", "exec python -m uvicorn backend.app.main:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
